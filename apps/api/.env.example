NODE_ENV="development"
LOG_LEVEL="info"
LOG_DIR="logs"

PORT=4000
DATABASE_URL="postgresql://postgres:password@localhost:5432/nfc_card_platform"

JWT_SECRET="change-this-secret-key-for-development-min-32-chars"
JWT_REFRESH_SECRET="change-this-refresh-secret-key-min-32-chars"

# OTP dispatch: "console" logs the code in development only
OTP_PROVIDER="console"
OTP_PEPPER="change-this-otp-pepper-min-32-chars"
OTP_TTL_MS=300000
OTP_SEND_WINDOW_MS=600000
OTP_SEND_MAX=3
OTP_MAX_ATTEMPTS=5
OTP_DIGITS=6

WEB_URL="http://localhost:3000,http://localhost:3001"

# File Upload / S3 Config (F-016)
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="nfc-card-platform"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_PUBLIC_BASE_URL="https://nfc-card-platform.s3.amazonaws.com"

# CDN Revalidation (F-017)
NEXT_REVALIDATE_URL="http://localhost:3000/api/revalidate"
NEXT_REVALIDATE_SECRET="revalidate-secret-token"
