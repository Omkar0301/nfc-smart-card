                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"+19876543210\",\n  \"otpCode\": \"123456\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/recover/phone",
                  "host": ["{{baseUrl}}"],
                  "path": ["auth", "recover", "phone"]
